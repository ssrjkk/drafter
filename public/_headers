/*
  Security headers for the static deployments (GitHub Pages has no header
  support, Cloudflare Pages and Netlify read this file). `frame-ancestors`
  is ignored inside a <meta> CSP, so without these headers the static build is
  clickjacked even though the served policy is otherwise identical to the
  nginx.conf / Caddyfile ones.
*/
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.anthropic.com https://api.groq.com https://api.openai.com https://generativelanguage.googleapis.com https://openrouter.ai https://api.deepseek.com https://api.together.xyz https://api.novita.ai https://api.lepton.ai https://api.github.com https://raw.githubusercontent.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
