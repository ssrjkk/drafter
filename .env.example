# Drafter Environment Variables
# Copy this file to .env and fill in the values

# API Configuration (optional - can be configured in-app)
# VITE_API_URL=https://api.anthropic.com/v1/messages
# VITE_MODEL=claude-sonnet-4-20250514
# VITE_MAX_TOKENS=8192

# Base path for the built app (default: /)
# Set to /drafter/ for GitHub Pages project sites
# VITE_BASE=/drafter/

# E2E Testing (optional)
# TEST_MASTER_PASSWORD=YourSecurePassword123
